{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hanzcamm-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hanzcamm-db", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }
  ],
  "r2_buckets": [
    { "binding": "DELIVERABLES", "bucket_name": "hanzcamm-deliverables" }
  ]
}
